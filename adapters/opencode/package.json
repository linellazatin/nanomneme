{
  "name": "@openlines/nmnm-opencode",
  "version": "0.1.0",
  "description": "OpenCode adapter for nanomneme local SQLite memory",
  "type": "module",
  "keywords": [
    "opencode",
    "plugin",
    "coding-agent",
    "memory",
    "adapter"
  ],
  "main": "./index.js",
  "exports": {
