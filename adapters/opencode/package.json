    "src",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "nmnm-memory": "./bin/memory.js"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.15",
    "jsonc-parser": "3.3.1",
    "@openlines/nmnm-core": "0.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Linel Lazatin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linellazatin/nanomneme.git",
    "directory": "adapters/opencode"
  }
